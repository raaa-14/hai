@charset "utf-8";

body { background-color: rgb(22, 21, 21); font-family: Arial, sans-serif; font-size: 14px; margin: 0px; }

#header { max-width: 600px; margin: 0px auto; padding-top: 16px; display: flex; align-items: center; justify-content: space-between; }

#header div:last-of-type a { color: rgb(255, 255, 255); text-decoration: none; margin-right: 16px; }

#header div:last-of-type a:last-of-type { margin-right: 0px; }

form { color: rgb(255, 255, 255); background-color: rgb(37, 37, 37); max-width: 568px; border-top: 2px solid rgb(0, 133, 255); border-radius: 4px; margin: 32px auto; padding: 16px; }

form div:nth-of-type(1) { line-height: 16px; text-overflow: ellipsis; white-space: nowrap; height: 16px; margin-bottom: 16px; overflow: hidden; }

form div:nth-of-type(2) { background-color: rgb(25, 25, 25); height: 48px; border: 1px solid rgb(60, 60, 60); border-radius: 4px; padding: 8px; display: flex; align-items: center; justify-content: center; }

form button, form input { font-family: Arial, sans-serif; height: 48px; border-radius: 4px; }

form button { color: rgb(255, 255, 255); background-color: rgb(0, 133, 255); font-size: 14px; border: none; margin-right: 16px; padding: 0px 16px; appearance: none; cursor: pointer; }

form button:last-of-type { margin-right: 0px; }

form input[type="text"] { color: rgb(125, 126, 154); background-color: transparent; font-size: 16px; width: 74.9091%; border: none; padding: 0px; outline: none; }

form #f { width: 9.27273%; border-top-right-radius: 0px; border-bottom-right-radius: 0px; margin: 0px 0.363636% 0px 1.45455%; padding: 0px; }

form button[type="submit"] { font-weight: normal; width: 14.7273%; border-top-left-radius: 0px; border-bottom-left-radius: 0px; padding: 0px; }

form i { border-width: 3px; border-style: solid; border-color: rgb(0, 133, 255) transparent; border-image: initial; border-radius: 50%; width: 16px; height: 16px; animation: 2s linear 0s infinite normal none running spin; margin-left: 4px; display: block; }

@keyframes spin { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

#text { color: rgb(157, 157, 157); max-width: 600px; margin: 0px auto 32px; }

#text h1, #text h2 { color: rgb(255, 255, 255); font-size: 22px; font-weight: normal; margin: 0px; }

#text p { line-height: 24px; text-align: justify; margin: 16px 0px 0px; }

#text ol { text-align: justify; list-style-position: inside; margin: 16px 0px; padding-left: 0px; }

#text li { line-height: 24px; margin-bottom: 8px; }

#text li:last-of-type { margin-bottom: 0px; }

#text a { color: rgb(157, 157, 157); }

#footer { text-align: center; max-width: 600px; border-top: 1px solid rgb(29, 29, 29); margin: 0px auto; padding: 16px 0px; }

#footer a { color: rgb(157, 157, 157); text-decoration: none; margin: 0px 8px; }

@media only screen and (max-width: 600px) {
  #header { padding: 16px 4%; }
  #header div:last-of-type a:nth-of-type(3) { display: none; }
  form input[type="text"] { width: 66.9091%; }
  form #f { width: 13.2727%; }
  form button[type="submit"] { width: 18.7273%; }
  #text { width: 92%; }
}
